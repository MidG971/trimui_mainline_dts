#!/bin/sh
# On suspend: blank the panel (screen off + DSI PHY gated = cool) AND turn the
# RGB indicator ring off (save brightness first), restoring both on resume.
SAVE=/run/led-ring-save
case "$1/$2" in
  pre/*)
    echo 4 > /sys/class/graphics/fb0/blank 2>/dev/null
    : > "$SAVE" 2>/dev/null
    for l in /sys/class/leds/rgb:indicator-*; do
      [ -e "$l/brightness" ] || continue
      echo "$l $(cat "$l/brightness")" >> "$SAVE" 2>/dev/null
      echo 0 > "$l/brightness" 2>/dev/null
    done
    ;;
  post/*)
    echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null
    if [ -f "$SAVE" ]; then
      while read -r l b; do echo "$b" > "$l/brightness" 2>/dev/null; done < "$SAVE"
      rm -f "$SAVE" 2>/dev/null
    fi
    ;;
esac
exit 0
